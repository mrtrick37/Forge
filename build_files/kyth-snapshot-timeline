#!/usr/bin/env bash
# Source-tree compatibility caller. The installed implementation is Rust.
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
repo_root="$(cd -- "${script_dir}/.." && pwd)"

for candidate in \
	/usr/bin/kyth-snapshot-timeline \
	"${repo_root}/src/kyth-shared-rs/target/release/kyth-snapshot-timeline" \
	"${repo_root}/src/kyth-shared-rs/target/debug/kyth-snapshot-timeline"; do
	if [[ -x "${candidate}" && "${candidate}" != "${BASH_SOURCE[0]}" ]]; then
		exec "${candidate}" "$@"
	fi
done

exec cargo run --quiet \
	--manifest-path "${repo_root}/src/kyth-shared-rs/Cargo.toml" \
	--bin kyth-snapshot-timeline -- "$@"
