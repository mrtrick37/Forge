[Unit]
Description=Kyth scheduler arbiter (single placement owner)
After=local-fs.target
Before=gamemode.service
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=oneshot
ExecStart=/usr/bin/kyth-tunable-rs sched-arbiter apply
RemainAfterExit=yes
# Runs once at boot to pick a placement owner, then stays "active" without
# doing further work — deprioritized so its brief startup work never
# competes with early session startup for cycles.
Nice=15
IOSchedulingClass=idle
CPUQuota=25%
MemoryMax=384M
# Restart= is not valid with Type=oneshot RemainAfterExit=yes.
PrivateTmp=yes
# PrivateUsers remaps root and cannot write /etc/gamemode.ini.
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
RuntimeDirectory=kyth
ReadWritePaths=-/etc/gamemode.ini
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallFilter=@system-service
SystemCallArchitectures=native
CapabilityBoundingSet=
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
UMask=0077
CacheDirectory=kyth
CacheDirectoryMode=0700

[Install]
WantedBy=multi-user.target
