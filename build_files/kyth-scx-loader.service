[Unit]
Description=KythOS sched-ext scheduler launcher
Documentation=https://github.com/sched-ext/scx
ConditionPathExists=/sys/kernel/sched_ext
ConditionPathExists=/etc/scx/scx_loader.conf
After=basic.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
ExecStart=/usr/bin/kyth-runtime scx-loader-service
Restart=on-failure
RestartSec=5
# This loads/manages the sched_ext scheduler itself, unlike the plain
# monitor daemons elsewhere in this repo — deliberately not deprioritized
# or CPU-throttled, since that's a different risk for a scheduler
# subsystem's own control process. Memory ceiling only, as a leak safety net.
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=multi-user.target
