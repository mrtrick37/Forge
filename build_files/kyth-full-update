#!/usr/bin/env bash
set -euo pipefail
# Rust owns the critical/optional run_step policy and shared fwupd lock:
# run_step critical "Flatpak user packages"
# run_step critical "Flatpak system packages"
# run_step critical "KythOS system image"
# run_step optional "Firmware upgrades" flock -w 60 /run/kyth-fwupd.lock sudo -n /usr/bin/fwupdmgr update --assume-yes --no-reboot-check
# run_step optional "Firmware metadata" flock -w 60 /run/kyth-fwupd.lock sudo -n /usr/bin/fwupdmgr refresh --force
# run_step optional "KythOS rclone"
# flatpak update, kyth-safe-upgrade, kyth-rclone-update
exec /usr/bin/kyth-runtime apply-update "$@"
