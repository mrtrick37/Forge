import { Button, CheckBox, ComboBox, LineEdit } from "std-widgets.slint";

export component InstallerWindow inherits Window {
    width: 1120px;
    height: 900px;
    title: "KythOS Installer";
    background: #0b1020;

    in-out property <string> status-text: "Installer backend not connected";
    in-out property <string> disk-summary: "Connect to see available install targets";
    in-out property <string> disk-details: "Disk inventory will appear after the installer service connects.";
    in-out property <string> transaction-text: "No install transaction recorded";
    in-out property <string> error-text: "";
    in-out property <string> selected-disk: "";
    in-out property <string> target-partition: "";
    in-out property <string> free-region-start: "0";
    in-out property <string> free-region-end: "0";
    in-out property <string> install-mode: "wipe";
    in-out property <string> kernel: "fedora";
    in-out property <string> resize-gib: "64";
    in-out property <string> timezone: "UTC";
    in-out property <string> locale: "en_US.UTF-8";
    in-out property <string> keymap: "us";
    in-out property <[string]> timezone-options: ["UTC"];
    in-out property <[string]> locale-options: ["en_US.UTF-8"];
    in-out property <[string]> keymap-options: ["us"];
    in-out property <string> manual-filesystem: "btrfs";
    in-out property <string> manual-mountpoint: "/";
    in-out property <string> manual-size-gib: "32";
    in-out property <string> manual-pending-index: "0";
    in-out property <string> manual-pending: "No pending partition operations.";
    in-out property <bool> manual-committed: false;
    in-out property <string> storage-details: "Select a disk to inspect its partitions and free space.";
    in-out property <string> partition-one: "";
    in-out property <string> partition-two: "";
    in-out property <string> partition-three: "";
    in-out property <string> partition-four: "";
    in-out property <string> partition-five: "";
    in-out property <string> partition-six: "";
    in-out property <string> free-region-one: "";
    in-out property <string> free-region-two: "";
    in-out property <string> free-region-three: "";
    in-out property <string> free-region-four: "";
    in-out property <string> free-region-five: "";
    in-out property <string> free-region-six: "";
    in-out property <string> disk-one: "";
    in-out property <string> disk-two: "";
    in-out property <string> disk-three: "";
    in-out property <string> disk-four: "";
    in-out property <string> disk-five: "";
    in-out property <string> disk-six: "";
    in-out property <string> hostname: "kyth";
    in-out property <string> username: "";
    in-out property <string> password: "";
    in-out property <string> mok-password: "";
    in-out property <bool> confirm-backup: false;
    in-out property <bool> confirm-erase: false;
    in-out property <bool> confirm-current: false;
    in-out property <bool> start-enabled: selected-disk != "" && username != "" && password != "" && confirm-backup && confirm-erase && (install-mode != "manual" || manual-committed) && (install-mode != "wipe" || confirm-current) && (install-mode != "alongside" || target-partition != "") && (install-mode != "resize_ntfs" || target-partition != "") && (install-mode != "free_space" || free-region-end != free-region-start);
    in-out property <bool> busy: false;
    in-out property <float> progress: 0;
    in-out property <string> event-log: "Waiting for installer events…";
    in-out property <string> selected-step: "Welcome";
    in-out property <string> step-title: "Welcome to KythOS";
    in-out property <string> step-detail: "Install the immutable gaming and development desktop with guarded, reviewable steps.";
    in-out property <string> step-status: "Reading native step status…";
    in-out property <string> step-progress: "Step 1 of 5";
    in-out property <string> next-label: "Continue";
    in-out property <bool> back-enabled: false;
    callback connect();
    callback select-step(string);
    callback next-step();
    callback previous-step();
    callback select-disk(string);
    callback select-target-partition(string);
    callback select-free-region(string);
    callback manual-action(string);
    callback select-mode(string);
    callback select-kernel(string);
    callback start-install();
    callback cancel-install();
    callback reboot();
    callback rescue-probe();

    Rectangle {
        background: #0b1020;
        HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 236px;
                background: #111a2e;
                VerticalLayout {
                    padding: 24px;
                    spacing: 12px;
                    Text { text: "KythOS"; color: #f5f7ff; font-size: 24px; font-weight: 700; }
                    Text { text: "System Installer"; color: #91a0bd; font-size: 13px; }
                    Rectangle { height: 20px; }
                    Button { text: "1  Welcome"; clicked => { selected-step = "Welcome"; select-step("Welcome"); } }
                    Button { text: "2  Select disk"; clicked => { selected-step = "Select disk"; select-step("Select disk"); } }
                    Button { text: "3  Configure"; clicked => { selected-step = "Configure"; select-step("Configure"); } }
                    Button { text: "4  Review"; clicked => { selected-step = "Review"; select-step("Review"); } }
                    Button { text: "5  Install"; clicked => { selected-step = "Install"; select-step("Install"); } }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: "Native Rust UI"; color: #60718f; font-size: 11px; }
                }
            }
            Rectangle {
                horizontal-stretch: 1;
                background: #0b1020;
                VerticalLayout {
                    padding: 32px;
                    spacing: 18px;
                    HorizontalLayout { Text { text: step-title; color: #f5f7ff; font-size: 30px; font-weight: 700; } Rectangle { horizontal-stretch: 1; } Text { text: step-progress; color: #55d6bd; font-size: 12px; vertical-alignment: center; } }
                    Text { text: step-detail; color: #9fb1d1; font-size: 15px; wrap: word-wrap; }
                    Text { text: step-status; color: #55d6bd; font-size: 13px; wrap: word-wrap; }
                    Rectangle { height: 18px; }
                    Rectangle {
                        height: 280px;
                        background: #17243d;
                        border-radius: 16px;
                        VerticalLayout {
                            padding: 22px;
                            spacing: 8px;
                            Text { text: "Connection status"; color: #9fb1d1; font-size: 13px; }
                            Text { text: status-text; color: #f5f7ff; font-size: 20px; font-weight: 600; wrap: word-wrap; }
                            Text { text: disk-summary; color: #9fb1d1; font-size: 14px; wrap: word-wrap; }
                            Text { text: disk-details; color: #d8e2f5; font-size: 13px; wrap: word-wrap; vertical-stretch: 1; }
                            Text { text: "Transaction state"; color: #9fb1d1; font-size: 12px; }
                            Text { text: transaction-text; color: #d9f8f0; font-size: 13px; wrap: word-wrap; }
                            Text { text: "The native shell never owns disk or boot mutations; those remain behind the installer service."; color: #7f90af; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    Text { text: error-text; color: #ff9d9d; font-size: 13px; wrap: word-wrap; visible: error-text != ""; }
                    Rectangle {
                        background: #121d33;
                        border-radius: 14px;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 8px;
                            Text { text: "Install request"; color: #f5f7ff; font-size: 15px; font-weight: 600; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Target"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                Button { text: disk-one; enabled: disk-one != ""; clicked => { selected-disk = disk-one; select-disk(disk-one); } }
                                Button { text: disk-two; enabled: disk-two != ""; clicked => { selected-disk = disk-two; select-disk(disk-two); } }
                                Button { text: disk-three; enabled: disk-three != ""; clicked => { selected-disk = disk-three; select-disk(disk-three); } }
                                Button { text: disk-four; enabled: disk-four != ""; clicked => { selected-disk = disk-four; select-disk(disk-four); } }
                                Button { text: disk-five; enabled: disk-five != ""; clicked => { selected-disk = disk-five; select-disk(disk-five); } }
                                Button { text: disk-six; enabled: disk-six != ""; clicked => { selected-disk = disk-six; select-disk(disk-six); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Mode"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                Button { text: "Erase disk"; clicked => { install-mode = "wipe"; select-mode("wipe"); } }
                                Button { text: "Keep Windows"; clicked => { install-mode = "resize_ntfs"; select-mode("resize_ntfs"); } }
                                Button { text: "Replace partition"; clicked => { install-mode = "alongside"; select-mode("alongside"); } }
                                Button { text: "Free space"; clicked => { install-mode = "free_space"; select-mode("free_space"); } }
                                Button { text: "Manual"; clicked => { install-mode = "manual"; select-mode("manual"); } }
                            }
                            Text { text: storage-details; color: #9fb1d1; font-size: 12px; wrap: word-wrap; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Partitions"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                Button { text: partition-one; enabled: partition-one != ""; clicked => { target-partition = partition-one; select-target-partition(partition-one); } }
                                Button { text: partition-two; enabled: partition-two != ""; clicked => { target-partition = partition-two; select-target-partition(partition-two); } }
                                Button { text: partition-three; enabled: partition-three != ""; clicked => { target-partition = partition-three; select-target-partition(partition-three); } }
                                Button { text: partition-four; enabled: partition-four != ""; clicked => { target-partition = partition-four; select-target-partition(partition-four); } }
                                Button { text: partition-five; enabled: partition-five != ""; clicked => { target-partition = partition-five; select-target-partition(partition-five); } }
                                Button { text: partition-six; enabled: partition-six != ""; clicked => { target-partition = partition-six; select-target-partition(partition-six); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Free space"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                Button { text: free-region-one; enabled: free-region-one != ""; clicked => { select-free-region(free-region-one); } }
                                Button { text: free-region-two; enabled: free-region-two != ""; clicked => { select-free-region(free-region-two); } }
                                Button { text: free-region-three; enabled: free-region-three != ""; clicked => { select-free-region(free-region-three); } }
                                Button { text: free-region-four; enabled: free-region-four != ""; clicked => { select-free-region(free-region-four); } }
                                Button { text: free-region-five; enabled: free-region-five != ""; clicked => { select-free-region(free-region-five); } }
                                Button { text: free-region-six; enabled: free-region-six != ""; clicked => { select-free-region(free-region-six); } }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Kernel"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                Button { text: "Fedora"; clicked => { kernel = "fedora"; select-kernel("fedora"); } }
                                Button { text: "CachyOS"; clicked => { kernel = "cachyos"; select-kernel("cachyos"); } }
                                Text { text: "KythOS size (GiB)"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                LineEdit { text <=> resize-gib; placeholder-text: "64"; }
                                Text { text: "Hostname"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                LineEdit { text <=> hostname; placeholder-text: "kyth"; }
                                Text { text: "User"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                LineEdit { text <=> username; placeholder-text: "Username"; }
                                Text { text: "Password"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                LineEdit { text <=> password; input-type: InputType.password; placeholder-text: "Password"; }
                            }
                            HorizontalLayout {
                                visible: kernel == "cachyos";
                                spacing: 8px;
                                Text { text: "MOK password"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                LineEdit { text <=> mok-password; input-type: InputType.password; placeholder-text: "Only needed if Secure Boot requests enrollment"; }
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: "Timezone"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                ComboBox { model: timezone-options; selected(value) => { timezone = value; } }
                                Text { text: "Locale"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                ComboBox { model: locale-options; selected(value) => { locale = value; } }
                                Text { text: "Keyboard"; color: #9fb1d1; font-size: 12px; vertical-alignment: center; }
                                ComboBox { model: keymap-options; selected(value) => { keymap = value; } }
                            }
                            Rectangle {
                                visible: install-mode == "manual";
                                background: #0d172a;
                                border-radius: 10px;
                                VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;
                                    Text { text: "Manual partition editor"; color: #f5f7ff; font-size: 13px; font-weight: 600; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Text { text: "Filesystem"; color: #9fb1d1; font-size: 11px; vertical-alignment: center; }
                                        LineEdit { text <=> manual-filesystem; placeholder-text: "btrfs"; }
                                        Text { text: "Mountpoint"; color: #9fb1d1; font-size: 11px; vertical-alignment: center; }
                                        LineEdit { text <=> manual-mountpoint; placeholder-text: "/"; }
                                        Text { text: "Size (GiB)"; color: #9fb1d1; font-size: 11px; vertical-alignment: center; }
                                        LineEdit { text <=> manual-size-gib; placeholder-text: "32"; }
                                    }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button { text: "New GPT"; clicked => { manual-action("new-table"); } }
                                        Button { text: "Create"; clicked => { manual-action("create"); } }
                                        Button { text: "Delete selected"; enabled: target-partition != ""; clicked => { manual-action("delete"); } }
                                        Button { text: "Format selected"; enabled: target-partition != ""; clicked => { manual-action("format"); } }
                                        Button { text: "Set mountpoint"; enabled: target-partition != ""; clicked => { manual-action("mountpoint"); } }
                                        Button { text: "Shrink selected"; enabled: target-partition != ""; clicked => { manual-action("resize"); } }
                                        Text { text: "Pending #"; color: #9fb1d1; font-size: 11px; vertical-alignment: center; }
                                        LineEdit { text <=> manual-pending-index; placeholder-text: "0"; }
                                        Button { text: "Remove pending"; clicked => { manual-action("remove-pending"); } }
                                    }
                                    Text { text: manual-pending; color: #9fb1d1; font-size: 11px; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 6px;
                                        Button { text: "Undo staged changes"; clicked => { manual-action("rollback"); } }
                                        Button { text: "Apply staged changes"; clicked => { manual-action("commit"); } }
                                        Text { text: manual-committed ? "Manual changes applied" : "Apply staged changes before installing."; color: #9fb1d1; font-size: 11px; vertical-alignment: center; wrap: word-wrap; }
                                    }
                                }
                            }
                            CheckBox { text: "I have backed up anything I want to keep."; checked <=> confirm-backup; }
                            CheckBox { text: "I understand the selected target may be erased."; checked <=> confirm-erase; }
                            CheckBox { text: "I verified the target and am booted from installation media."; checked <=> confirm-current; }
                        }
                    }
                    Rectangle {
                        background: #17243d;
                        border-radius: 14px;
                        VerticalLayout {
                            padding: 18px;
                            spacing: 8px;
                            Text { text: "Install activity"; color: #f5f7ff; font-size: 15px; font-weight: 600; }
                            Rectangle {
                                height: 8px;
                                background: #0d172a;
                                border-radius: 4px;
                                clip: true;
                                Rectangle {
                                    width: parent.width * progress / 100.0;
                                    height: parent.height;
                                    background: #55d6bd;
                                    border-radius: 4px;
                                }
                            }
                            Text { text: event-log; color: #d8e2f5; font-size: 12px; wrap: word-wrap; }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    HorizontalLayout {
                        Button { text: "‹  Back"; enabled: back-enabled; clicked => { previous-step(); } }
                        Button { text: next-label; clicked => { next-step(); } }
                        Button { text: "Connect to installer"; clicked => { connect(); } }
                        Button { text: "Start install"; enabled: start-enabled && !busy; clicked => { start-install(); } }
                        Button { text: "Cancel"; enabled: busy; clicked => { cancel-install(); } }
                        Button { text: "Rescue probe"; clicked => { rescue-probe(); } }
                        Button { text: "Reboot"; enabled: selected-step == "Done"; clicked => { reboot(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: "Review every destructive step before applying"; color: #60718f; font-size: 12px; vertical-alignment: center; }
                    }
                }
            }
        }
    }
}
